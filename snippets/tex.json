  {
  "mk": {
    "prefix": "mk",
    "body": "\\$${1}\\$",
    "description": "inline math"
  },

  "dm": {
    "prefix": "dm",
    "body": [
      "\\$\\$",
      "\t$1",
      "\\$\\$"
    ],
    "description": "display math"
  },

  "rd": {
    "prefix": "rd",
    "body": "^{$1}"
  },

  "frac": {
    "prefix": "//",
    "body": "\\frac{$1}{$2}"
  },

  "sqrt": {
    "prefix": "sq",
    "body": "\\sqrt{$1}"
  },

  "sum": {
    "prefix": "sum",
    "body": "\\sum_{${1:n=1}}^{${2:\\infty}} $3"
  },

  "lim": {
    "prefix": "lim",
    "body": "\\lim_{${1:n}\\to${2:\\infty}} "
  },

  "align": {
    "prefix": "al",
    "body": [
      "\\begin{align}",
      "\t$1",
      "\\end{align}"
    ]
  },

  "beg": {
    "prefix": "beg",
    "body": [
      "\\begin{${1:environment}}",
      "\t${2}",
      "\\end{${1:environment}}"
    ],
    "description": "LaTeX environment block"
  },
  "bb": {
    "prefix": "bb",
    "body": "\\mathbb{$1}"
  },

  "equation": {
    "prefix": "eq",
    "body": [
      "\\begin{equation}",
      "\t$1",
      "\\end{equation}"
    ]
  },

  "itemize": {
    "prefix": "item",
    "body": [
      "\\begin{itemize}",
      "\t\\item $1",
      "\\end{itemize}"
    ]
  },

  "enumerate": {
    "prefix": "enum",
    "body": [
      "\\begin{enumerate}",
      "\t\\item $1",
      "\\end{enumerate}"
    ]
  }
}
