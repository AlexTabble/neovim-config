{
  "eq": {
    "prefix": ["eq"],
    "body": ["\\$\\$", "$1", "\\$\\$"]
  },
  "def": {
    "prefix": ["def"],
    "body": [":::{#def-$1}", "## $2\n", "$3", ":::"]
  },
  "Insert Block Equation": {
    "prefix": "$$",
    "body": ["\\$$", "${0}", "\\$$"]
  },
  "img": {
    "prefix": ["img"],
    "body": ["![](./img/$1)"]
  },
  "br": {
    "prefix": ["br"],
    "body": ["<br/>"]
  },
  "todo": {
    "prefix": ["todo"],
    "body": ["* [ ] ${1:task} -- due:${2:today} ${3: project:}"]
  },
  "/": {
      "body": "\\\\frac{${VISUAL}}{$1}$0",
      "description": "Fraction",
      "prefix": "/"
  },
  "//": {
      "body": "\\\\frac{$1}{$2}$0",
      "description": "Fraction",
      "prefix": "//"
  },
  "<=": {
      "body": "\\le ",
      "description": "leq",
      "prefix": "<="
  },
  ">=": {
      "body": "\\ge ",
      "description": "geq",
      "prefix": ">="
  },
  "eqalign": {
    "body": "\\begin{aligned}\n\t$0\n\\end{aligned}",
    "description": "Align",
    "prefix": "eqalign"
  },
  "mk" : {
    "body" : "\\$$0\\$",
    "description" : "inline-math",
    "prefix":"mk"
  },
  "dm" : {
    "body": "\\$\\$\n$0\n\\$\\$",
    "description":"block-math",
    "prefix": "dm"
  },

  "beg": {
    "prefix": "beg",
    "body": [
      "\\begin{${1:environment}}",
      "\t${2}",
      "\\end{${1:environment}}"
    ],
    "description": "LaTeX environment block"
  },
  "bold" : {
    "prefix" : "bf",
    "body": "**$0**",
    "description": "Bold Font"
  },
  
  "italic" : {
    "prefix" : "it",
    "body": "*$0*",
    "description": "Italic Font"
  },
  "pycode": {
    "prefix": ["pyc"],
    "body": ["```{python} ", "$1", "```"]
  },
  "rcode": {
    "prefix": ["rco"],
    "body": ["```{r} ", "$1", "```"]
  }
}
