{
  "eq": {
    "prefix": ["eq"],
    "body": ["\\$\\$", "$1", "\\$\\$"]
  },
  "def": {
    "prefix": ["def"],
    "body": [":::{#def-$1}", "## $2\n", "$3", ":::"]
  },
  "Insert Block Equation": {
    "prefix": "$$",
    "body": ["\\$$", "${0}", "\\$$"]
  },
  "img": {
    "prefix": ["img"],
    "body": ["![](./img/$1)"]
  },
  "br": {
    "prefix": ["br"],
    "body": ["<br/>"]
  },
  "todo": {
    "prefix": ["todo"],
    "body": ["* [ ] ${1:task} -- due:${2:today} ${3: project:}"]
  },
  "/": {
      "body": "\\\\frac{${VISUAL}}{$1}$0",
      "description": "Fraction",
      "prefix": "/"
  },
  "//": {
      "body": "\\\\frac{$1}{$2}$0",
      "description": "Fraction",
      "prefix": "//"
  },
  "<=": {
      "body": "\\le ",
      "description": "leq",
      "prefix": "<="
  },
  ">=": {
      "body": "\\ge ",
      "description": "geq",
      "prefix": ">="
  },
  "eqalign": {
    "body": "\\begin{aligned}\n\t$0\n\\end{aligned}",
    "description": "Align",
    "prefix": "eqalign"
  },
}
